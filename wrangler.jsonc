{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-chat-app-david-ai1",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],

  /**
   * 靜態資源綁定 - 這是修正錯誤的關鍵！
   * env.ASSETS 就是靠這段設定產生的
   */
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  /**
   * Workers AI 綁定
   */
  "ai": {
    "binding": "AI"
  },

  /**
   * 觀測性（強烈建議開啟，可以在 Dashboard 看到 log）
   */
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
